CFLAGS_D_WEXE32 = /nologo /DWIN32S /D_X86_ /W3 /FR /D_DEBUG /Zi /DWIN32 /D_WINDOWS /Fd"NOTEPAD.PDB"
CFLAGS_R_WEXE32 = /nologo /DWIN32S /D_X86_ /W3 /FR /Ox /DNDEBUG /D_WINDOWS /DWIN32 /D_WINDOWS 
LFLAGS_D_WEXE32 = /NOLOGO /DEBUG  /DEBUGTYPE:cv /SUBSYSTEM:windows user32.lib gdi32.lib kernel32.lib olesvr32.lib comdlg32.lib shell32.lib
LFLAGS_R_WEXE32 = /NOLOGO /SUBSYSTEM:windows user32.lib gdi32.lib kernel32.lib olesvr32.lib comdlg32.lib shell32.lib
LFLAGS_D_LIB32 = /NOLOGO
LFLAGS_R_LIB32 = /NOLOGO
