NOTEPAD.RES:	NOTEPAD.RC $(NOTEPAD_RCDEP)
	$(RC) $(RCFLAGS32) $(RCDEFINES) -r NOTEPAD.RC


$(PROJ).EXE:	NOTEPAD.RES

$(PROJ).EXE:	NOTEPAD.OBJ NPDATE.OBJ NPFILE.OBJ NPINIT.OBJ NPMISC.OBJ LSTRFNS.OBJ NPPRINT.OBJ $(OBJS_EXT)
	echo >NUL @<<$(PROJ).CRF
