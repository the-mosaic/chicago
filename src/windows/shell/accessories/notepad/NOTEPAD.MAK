SBRS = NOTEPAD.SBR \
		NPDATE.SBR \
		NPINIT.SBR \
		NPMISC.SBR \
		NPPRINT.SBR \
		LSTRFNS.SBR

NOTEPAD_DEP = .\notepad.h


NPDATE_DEP = .\notepad.h


NPFILE_DEP = .\notepad.h


NPINIT_DEP = .\notepad.h


NPMISC_DEP = .\notepad.h \
	.\lstrfns.h \

NPPRINT_DEP = .\notepad.h \
	.\dlgs.h

LSTRFNS_DEP = .\lstrfns.h


NOTEPAD_RCDEP = .\notepad.h \
	.\notepad.ico \
	.\notepad.dlg


all:	$(PROJ).EXE $(PROJ).BSC

NOTEPAD.OBJ:	NOTEPAD.C $(NOTEPAD_DEP)
